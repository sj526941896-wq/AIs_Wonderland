---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import profile from '../content/profile.json';
import { getEntrySlug, entryPath } from '../lib/entries';

const entries = await getCollection('entries');
const published = entries
  .filter((e) => !e.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);

function fmtDate(date: Date) {
  return date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<BaseLayout title="涂工 · AI 网球教学与咨询" currentPage="home">
  <div class="container">
    <header class="hero">
      <span class="hero-badge">ais.aitennis.top</span>
      <h1>{profile.name}</h1>
      <p class="hero-lead">{profile.tagline}</p>
      <p class="hero-lead" style="font-size: 0.95rem; margin-top: -1rem;">{profile.bio}</p>
      <div class="hero-actions">
        <a href="/consult/?from=home" class="btn btn-primary">预约动作诊断</a>
        <a href="/learn/forehand/" class="btn btn-secondary">第一篇 · 正手动力链</a>
      </div>
    </header>

    <section class="section">
      <h2 class="section-title">咨询服务</h2>
      <div class="card">
        <h3>{profile.consult.skuTitle}</h3>
        <p class="price-tag">{profile.consult.skuPrice}</p>
        <p>{profile.consult.skuNote}</p>
        <a href="/consult/" class="btn btn-primary" style="margin-top: 1rem;">查看咨询基地 →</a>
      </div>
    </section>

    <section class="section">
      <h2 class="section-title">
        交互教学
        <a href="/learn/">全部专题</a>
      </h2>
      <div class="card-grid card-grid-2">
        <a href="/learn/forehand/" class="card entry-preview">
          <p class="entry-preview-date">第一篇 · 已上线</p>
          <p class="entry-preview-title">职业正手的力量 · 交互动画</p>
        </a>
        <div class="card" style="opacity: 0.7;">
          <p class="entry-preview-date">筹备中</p>
          <p class="entry-preview-title">发球 · 步伐 · 节奏</p>
        </div>
      </div>
    </section>

    <section class="section">
      <h2 class="section-title">
        最新动态
        <a href="/journal/">全部资讯</a>
      </h2>
      <div class="card-grid">
        {
            published.map((entry) => (
            <a href={entryPath(getEntrySlug(entry))} class="card entry-preview">
              <p class="entry-preview-date">{fmtDate(entry.data.date)}</p>
              <p class="entry-preview-title">{entry.data.title}</p>
            </a>
          ))
        }
      </div>
      {published.length === 0 && (
        <p style="color: var(--text-muted); text-align: center;">暂无发布内容</p>
      )}
    </section>

    <section class="section card qr-block">
      <h2 style="font-size: 1.1rem; margin-bottom: 0.75rem;">飞书联系</h2>
      <img src="/images/feishu-me.png" alt="飞书二维码" class="qr-code" width="140" height="140" />
      <p class="qr-label">扫码咨询 · 备注「网球咨询」</p>
    </section>

    <footer class="site-footer">
      <p>公众号读摘要 · 网站学完整 · <a href="/consult/">咨询基地</a></p>
    </footer>
  </div>
</BaseLayout>
