---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import profile from '../content/profile.json';

const entries = await getCollection('entries');
const published = entries
  .filter((e) => !e.data.draft)
  .sort((a, b) => {
    const d = b.data.date.valueOf() - a.data.date.valueOf();
    return d !== 0 ? d : b.id.localeCompare(a.id);
  });

const allTags = [...new Set(published.flatMap((e) => e.data.tags))];

function fmtDate(date) {
  return date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<BaseLayout title="AI 学习之旅 | 个人博客">
  <div class="container">
    <header class="profile">
      <div class="avatar">📖</div>
      <h1 id="profileName">{profile.name}</h1>
      <p class="profile-desc" id="profileBio">{profile.bio}</p>
      <div class="qr-section">
        <img src="/images/feishu-me.png" alt="飞书二维码" class="qr-code">
        <p class="qr-label">扫码联系我</p>
      </div>
    </header>

    <section class="search-wrap">
      <span class="search-icon">🔍</span>
      <input type="text" id="searchInput" class="search-input" placeholder="搜索学习记录...">
    </section>

    <section>
      <div class="filter-tags" id="filterTags">
        <button class="filter-tag active" data-tag="">全部</button>
        {allTags.map((tag) => (
          <button class="filter-tag" data-tag={tag}>{tag}</button>
        ))}
      </div>

      <div class="timeline" id="timeline">
        {
          published.length === 0 ? (
            <div class="empty-state">
              <div class="empty-icon">📝</div>
              <p>还没有学习记录</p>
              <p>期待与你分享第一篇内容</p>
            </div>
          ) : (
            published.map(async (entry, i) => {
              const { Content } = await entry.render();
              return (
                <article class="entry" data-index={i} data-title={entry.data.title} data-tags={entry.data.tags.join(',')}>
                  <div class="entry-header">
                    <div class="entry-date">{fmtDate(entry.data.date)}</div>
                    <h2 class="entry-title">{entry.data.title}</h2>
                    <span class="entry-toggle">展开</span>
                  </div>
                  <div class="entry-body">
                    <div class="entry-content md-body"><Content /></div>
                    {
                      entry.data.tags.length > 0 && (
                        <div class="entry-tags">
                          {entry.data.tags.map((tag) => (
                            <span class="entry-tag">{tag}</span>
                          ))}
                        </div>
                      )
                    }
                    {
                      entry.data.achievement && (
                        <div class="entry-achievement">
                          <div class="entry-achievement-label">✨ 成果与收获</div>
                          <div class="entry-achievement-content">{entry.data.achievement}</div>
                        </div>
                      )
                    }
                  </div>
                </article>
              );
            })
          )
        }
      </div>
    </section>

    <footer class="footer">
      <p>用心记录每一天的成长 🌱</p>
    </footer>
  </div>
</BaseLayout>

<script>
  import '../scripts/index.js';
</script>

<style is:global>
  body {
    --bg: #faf9f7;
    --card-bg: #ffffff;
    --text: #2d2a26;
    --text-muted: #6b6560;
    --border: #e8e4df;
    --accent: #e07a5f;
    --accent-hover: #c9694f;
    --tag-bg: #f3ebe6;
    --tag-text: #b85c3f;

    background: var(--bg);
    color: var(--text);
  }

  .profile {
    padding: 4rem 0 3rem;
    text-align: center;
  }

  .avatar {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--accent), #f4a261);
    margin: 0 auto 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    color: white;
  }

  .profile h1 {
    font-size: 1.75rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    letter-spacing: -0.02em;
  }

  .profile-desc {
    color: var(--text-muted);
    font-size: 0.95rem;
    max-width: 480px;
    margin: 0 auto;
  }

  .qr-section {
    margin-top: 2rem;
    text-align: center;
  }

  .qr-code {
    width: 140px;
    height: 140px;
    border-radius: 12px;
    border: 2px solid var(--border);
    padding: 4px;
    background: white;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .qr-code:hover {
    transform: scale(1.05);
    box-shadow: 0 4px 20px rgba(0,0,0,0.1);
  }

  .qr-label {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-top: 0.5rem;
  }

  .search-wrap {
    position: relative;
    margin-bottom: 2.5rem;
  }

  .search-icon {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-muted);
    font-size: 1.1rem;
  }

  .search-input {
    width: 100%;
    padding: 0.9rem 1rem 0.9rem 2.75rem;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 12px;
    font-size: 1rem;
    color: var(--text);
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
  }
  .search-input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 2px 12px rgba(224, 122, 95, 0.1);
  }

  .filter-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2.5rem;
  }

  .filter-tag {
    background: var(--tag-bg);
    color: var(--tag-text);
    padding: 0.35rem 0.9rem;
    border-radius: 15px;
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.2s;
    border: none;
  }
  .filter-tag:hover,
  .filter-tag.active {
    background: var(--accent);
    color: white;
  }

  .timeline {
    position: relative;
    padding-left: 1.5rem;
  }
  .timeline::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--border);
  }

  .entry {
    position: relative;
    background: var(--card-bg);
    border-radius: 16px;
    padding: 1.75rem;
    margin-bottom: 1.5rem;
    border: 1px solid var(--border);
    box-shadow: 0 2px 8px rgba(0,0,0,0.03);
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .entry:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(0,0,0,0.06);
  }
  .entry::before {
    content: '';
    position: absolute;
    left: -1.5rem;
    top: 2rem;
    width: 10px;
    height: 10px;
    background: var(--accent);
    border-radius: 50%;
    border: 3px solid var(--bg);
  }

  .entry-header {
    cursor: pointer;
    position: relative;
  }

  .entry-date {
    font-size: 0.85rem;
    color: var(--accent);
    font-weight: 500;
    margin-bottom: 0.3rem;
  }

  .entry-title {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-bottom: 0;
  }

  .entry-toggle {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    font-size: 0.8rem;
    color: var(--text-muted);
    padding: 0.25rem 0.5rem;
    border-radius: 6px;
    background: var(--tag-bg);
    transition: all 0.2s;
  }
  .entry.expanded .entry-toggle {
    background: var(--accent);
    color: white;
  }

  .entry-body {
    display: none;
    margin-top: 1rem;
    animation: fadeIn 0.25s ease;
  }
  .entry.expanded .entry-body {
    display: block;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(-8px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .entry-content {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin-bottom: 1rem;
  }

  .md-body p {
    margin-bottom: 0.75rem;
  }
  .md-body ul,
  .md-body ol {
    margin-left: 1.5rem;
    margin-bottom: 0.75rem;
  }
  .md-body li {
    margin-bottom: 0.25rem;
  }
  .md-body strong {
    font-weight: 600;
    color: var(--text);
  }
  .md-body code {
    background: var(--tag-bg);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    font-size: 0.9em;
  }
  .md-body pre code {
    background: none;
    padding: 0;
  }
  .md-body img {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    display: block;
    margin: 1rem auto;
  }

  .entry-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1rem;
  }

  .entry-tag {
    background: var(--tag-bg);
    color: var(--tag-text);
    padding: 0.2rem 0.6rem;
    border-radius: 10px;
    font-size: 0.8rem;
  }

  .entry-achievement {
    background: linear-gradient(135deg, #fdf8f6, #faf5f2);
    border-left: 3px solid var(--accent);
    padding: 0.9rem 1.1rem;
    border-radius: 0 10px 10px 0;
    margin-top: 1rem;
  }

  .entry-achievement-label {
    font-size: 0.8rem;
    color: var(--accent);
    font-weight: 600;
    margin-bottom: 0.3rem;
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  .entry-achievement-content {
    color: var(--text);
    font-size: 0.95rem;
    white-space: pre-wrap;
  }

  .empty-state {
    text-align: center;
    padding: 4rem 2rem;
    color: var(--text-muted);
  }
  .empty-icon {
    font-size: 3.5rem;
    margin-bottom: 1rem;
    opacity: 0.5;
  }
  .empty-state p {
    font-size: 1rem;
  }
  .empty-state p:first-of-type {
    margin-bottom: 0.5rem;
  }

  .empty-search {
    display: none;
    text-align: center;
    padding: 4rem 2rem;
    color: var(--text-muted);
  }
  .empty-search.visible {
    display: block;
  }

  .footer {
    text-align: center;
    padding: 3rem 0;
    color: var(--text-muted);
    font-size: 0.85rem;
    border-top: 1px solid var(--border);
    margin-top: 2rem;
  }

  @media (max-width: 600px) {
    .profile { padding: 3rem 0 2rem; }
    .profile h1 { font-size: 1.5rem; }
    .entry { padding: 1.25rem; }
    .entry-title { font-size: 1.1rem; }
  }
</style>
