---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getEntrySlug, entryPath, getListDescription } from '../lib/entries';
import '../styles/entries.css';

const entries = await getCollection('entries');
const published = entries
  .filter((e) => !e.data.draft)
  .sort((a, b) => {
    const d = b.data.date.valueOf() - a.data.date.valueOf();
    return d !== 0 ? d : b.id.localeCompare(a.id);
  });

const allTags = [...new Set(published.flatMap((e) => e.data.tags))];

function fmtDate(date: Date) {
  return date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<BaseLayout title="网球资讯与学习记录 | 涂工网球" currentPage="journal">
  <div class="container">
    <header class="page-header">
      <h1>资讯与学习记录</h1>
      <p>网球日报、工作流心得与技术笔记。深度教学请前往 <a href="/learn/">交互教学</a>。</p>
    </header>

    <section class="search-wrap">
      <span class="search-icon">🔍</span>
      <input type="text" id="searchInput" class="search-input" placeholder="搜索记录..." />
    </section>

    <section>
      <div class="filter-tags" id="filterTags">
        <button type="button" class="filter-tag active" data-tag="">全部</button>
        {allTags.map((tag) => (
          <button type="button" class="filter-tag" data-tag={tag}>
            {tag}
          </button>
        ))}
      </div>

      <div class="journal-list" id="journalList">
        {
          published.length === 0 ? (
            <div class="empty-state">
              <div class="empty-icon">📝</div>
              <p>还没有记录</p>
            </div>
          ) : (
            published.map((entry) => {
              const slug = getEntrySlug(entry);
              const excerpt = getListDescription(entry);
              return (
                <article
                  class="journal-card entry"
                  data-title={entry.data.title}
                  data-tags={entry.data.tags.join(',')}
                  data-excerpt={excerpt}
                >
                  <div class="entry-date">{fmtDate(entry.data.date)}</div>
                  <h2 class="journal-card-title">
                    <a href={entryPath(slug)}>{entry.data.title}</a>
                  </h2>
                  {excerpt && <p class="journal-card-excerpt">{excerpt}</p>}
                  {
                    entry.data.tags.length > 0 && (
                      <div class="entry-tags">
                        {entry.data.tags.map((tag) => (
                          <span class="entry-tag">{tag}</span>
                        ))}
                      </div>
                    )
                  }
                  <a href={entryPath(slug)} class="journal-read-more">
                    阅读全文 →
                  </a>
                </article>
              );
            })
          )
        }
      </div>

      <div class="empty-search" id="emptySearch">
        <div class="empty-icon">🔍</div>
        <p>没有匹配的记录</p>
      </div>
    </section>

    <footer class="site-footer">
      <p>
        <a href="/consult/">预约咨询</a> · <a href="/">返回首页</a>
      </p>
    </footer>
  </div>
</BaseLayout>

<script>
  import '../scripts/journal-list.js';
</script>

<style>
  .journal-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .journal-card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1.5rem;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .journal-card::before {
    display: none;
  }
  .journal-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
  }
  .journal-card-title {
    font-size: 1.2rem;
    font-weight: 600;
    margin: 0.25rem 0 0.5rem;
  }
  .journal-card-title a {
    color: var(--text);
    text-decoration: none;
  }
  .journal-card-title a:hover {
    color: var(--accent);
  }
  .journal-card-excerpt {
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.65;
    margin-bottom: 0.75rem;
  }
  .journal-read-more {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
  }
  .journal-read-more:hover {
    text-decoration: underline;
  }
  .empty-search {
    display: none;
    text-align: center;
    padding: 3rem 2rem;
    color: var(--text-muted);
  }
  .empty-search.visible {
    display: block;
  }
</style>
