---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import profile from '../content/profile.json';

const entries = await getCollection('entries');
const published = entries
  .filter((e) => !e.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function fmtDate(date) {
  return date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<BaseLayout title="管理 - AI Learning Journey">
  <!-- Password Gate -->
  <div class="password-overlay" id="passwordOverlay">
    <div class="password-box">
      <h2>管理后台</h2>
      <p>请输入访问密码</p>
      <input type="password" id="passwordInput" placeholder="输入密码...">
      <div class="password-error" id="passwordError">密码错误，请重试</div>
      <button id="passwordBtn">进入</button>
    </div>
  </div>

  <!-- Admin Content -->
  <div class="admin-content" id="adminContent">
    <div class="container">
      <header>
        <h1>管理学习记录</h1>
        <a href="/" class="back-link">← 返回首页</a>
      </header>

      <!-- .md Generator -->
      <section class="input-section">
        <h2>📝 Markdown 生成器</h2>
        <p class="section-desc">填写表单，复制生成的 Markdown 内容，保存到 <code>src/content/entries/</code></p>
        <form id="mdForm">
          <div class="form-row">
            <div class="form-group">
              <label for="date">日期</label>
              <input type="date" id="date" required>
            </div>
            <div class="form-group">
              <label for="title">标题</label>
              <input type="text" id="title" placeholder="文章标题" required>
            </div>
          </div>
          <div class="form-group">
            <label for="tags">标签（逗号分隔）</label>
            <input type="text" id="tags" placeholder="AI, Python, 入门">
          </div>
          <div class="form-group">
            <label for="achievement">成果/收获</label>
            <textarea id="achievement" placeholder="今天的收获和成果..."></textarea>
          </div>
          <div class="form-group">
            <label for="content">正文（Markdown）</label>
            <textarea id="content" placeholder="支持 Markdown 语法..." rows="10"></textarea>
          </div>
          <button type="submit" class="btn btn-primary">生成 Markdown</button>
        </form>
      </section>

      <!-- Generated output -->
      <section class="input-section" id="outputSection" style="display:none">
        <h2>📋 复制以下内容</h2>
        <p class="section-desc">保存为 <code>src/content/entries/文件名.md</code></p>
        <pre class="md-output" id="mdOutput"></pre>
        <button class="btn btn-primary" id="copyBtn">复制到剪贴板</button>
      </section>

      <!-- Existing .md entries -->
      <section>
        <h2 class="section-title">现有文章（{published.length} 篇）</h2>
        {published.length === 0 ? (
          <div class="empty-state">还没有 .md 文章</div>
        ) : (
          <div class="md-file-list">
            {published.map((entry) => (
              <div class="md-file-item">
                <div class="md-file-date">{fmtDate(entry.data.date)}</div>
                <div class="md-file-title">{entry.data.title}</div>
                {entry.data.tags.length > 0 && (
                  <div class="md-file-tags">
                    {entry.data.tags.map((tag) => <span class="md-file-tag">{tag}</span>)}
                  </div>
                )}
                <div class="md-file-path">{entry.id}</div>
              </div>
            ))}
          </div>
        )}
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  import '../scripts/admin.js';
</script>

<style is:global>
  body {
    --primary: #6366f1;
    --primary-dark: #4f46e5;
    --bg: #0f172a;
    --card-bg: #1e293b;
    --text: #e2e8f0;
    --text-muted: #94a3b8;
    --border: #334155;
    --accent: #22d3ee;

    background: var(--bg);
    color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    min-height: 100vh;
  }

  .container {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  .password-overlay {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background: var(--bg);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
  }
  .password-box {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 2.5rem;
    text-align: center;
    max-width: 360px;
    width: 90%;
  }
  .password-box h2 { color: var(--text); font-size: 1.3rem; margin-bottom: 0.5rem; }
  .password-box p { color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1.5rem; }
  .password-box input {
    width: 100%;
    padding: 0.9rem 1rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    color: var(--text);
    font-size: 1rem;
    text-align: center;
    margin-bottom: 1rem;
  }
  .password-box input:focus { outline: none; border-color: var(--primary); }
  .password-error { color: #ef4444; font-size: 0.85rem; margin-bottom: 1rem; display: none; }
  .password-box button {
    width: 100%;
    padding: 0.9rem;
    background: var(--primary);
    color: white;
    border: none;
    border-radius: 10px;
    font-size: 1rem;
    cursor: pointer;
  }
  .password-box button:hover { background: var(--primary-dark); }

  .admin-content { display: none; }

  header {
    margin-bottom: 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  h1 {
    font-size: 2rem;
    background: linear-gradient(135deg, var(--primary), var(--accent));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .back-link { color: var(--accent); text-decoration: none; font-size: 0.9rem; }
  .back-link:hover { text-decoration: underline; }

  .input-section {
    background: var(--card-bg);
    border-radius: 12px;
    padding: 1.5rem;
    margin-bottom: 2rem;
    border: 1px solid var(--border);
  }
  .input-section h2 { font-size: 1.2rem; margin-bottom: 0.5rem; color: var(--accent); }
  .section-desc { color: var(--text-muted); font-size: 0.85rem; margin-bottom: 1rem; }
  .section-desc code {
    background: var(--bg);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    font-size: 0.9em;
  }

  .section-title {
    margin-bottom: 1rem;
    color: var(--text-muted);
    font-size: 1rem;
  }

  .form-group { margin-bottom: 1rem; }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  label { display: block; margin-bottom: 0.3rem; color: var(--text-muted); font-size: 0.9rem; }
  input, textarea {
    width: 100%;
    padding: 0.75rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text);
    font-size: 1rem;
    font-family: inherit;
  }
  input:focus, textarea:focus { outline: none; border-color: var(--primary); }
  textarea { min-height: 100px; resize: vertical; }

  .btn {
    padding: 0.75rem 1.5rem;
    border: none;
    border-radius: 8px;
    font-size: 1rem;
    cursor: pointer;
    transition: all 0.2s;
  }
  .btn-primary { background: var(--primary); color: white; }
  .btn-primary:hover { background: var(--primary-dark); }

  .md-output {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1rem;
    font-family: 'SF Mono', 'Fira Code', monospace;
    font-size: 0.85rem;
    line-height: 1.6;
    white-space: pre-wrap;
    overflow-x: auto;
    margin-bottom: 1rem;
    max-height: 400px;
    overflow-y: auto;
  }

  .md-file-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .md-file-item {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1rem 1.25rem;
  }
  .md-file-date { color: var(--accent); font-size: 0.85rem; }
  .md-file-title { font-size: 1.1rem; margin-top: 0.25rem; }
  .md-file-tags { display: flex; flex-wrap: wrap; gap: 0.3rem; margin-top: 0.5rem; }
  .md-file-tag {
    background: var(--bg);
    color: var(--primary);
    padding: 0.15rem 0.5rem;
    border-radius: 10px;
    font-size: 0.75rem;
  }
  .md-file-path {
    color: var(--text-muted);
    font-size: 0.8rem;
    margin-top: 0.5rem;
    font-family: 'SF Mono', monospace;
  }

  .empty-state { text-align: center; padding: 2rem; color: var(--text-muted); }

  .copied-toast {
    position: fixed;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    background: var(--primary);
    color: white;
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    font-size: 0.9rem;
    z-index: 9999;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .copied-toast.show { opacity: 1; }

  @media (max-width: 600px) {
    .form-row { grid-template-columns: 1fr; }
  }
</style>
