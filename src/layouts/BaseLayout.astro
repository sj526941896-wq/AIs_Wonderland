---
export interface Props {
  title?: string;
  currentPage?: 'entries' | 'logs';
}

const { title = 'AI 学习之旅', currentPage = 'entries' } = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <nav class="top-nav">
      <div class="container nav-inner">
        <a href="/" class="nav-logo">🏠 {title}</a>
        <div class="nav-links">
          <a href="/" class={`nav-link${currentPage === 'entries' ? ' active' : ''}`}>📖 学习记录</a>
        </div>
      </div>
    </nav>
    <slot />
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans SC', sans-serif;
    line-height: 1.8;
    min-height: 100vh;
  }

  .container {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* --- Navigation --- */
  .top-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(250, 249, 247, 0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border, #e8e4df);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0;
    padding-bottom: 0;
    height: 56px;
  }

  .nav-logo {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text, #2d2a26);
    text-decoration: none;
    white-space: nowrap;
  }

  .nav-links {
    display: flex;
    gap: 0.25rem;
  }

  .nav-link {
    font-size: 0.85rem;
    color: var(--text-muted, #6b6560);
    text-decoration: none;
    padding: 0.4rem 0.75rem;
    border-radius: 8px;
    transition: all 0.2s;
    white-space: nowrap;
  }
  .nav-link:hover {
    background: var(--tag-bg, #f3ebe6);
    color: var(--text, #2d2a26);
  }
  .nav-link.active {
    background: var(--accent, #e07a5f);
    color: white;
  }

  @media (max-width: 480px) {
    .nav-logo { font-size: 0.85rem; }
    .nav-link { font-size: 0.8rem; padding: 0.35rem 0.5rem; }
    .nav-inner { gap: 0.5rem; }
  }
</style>
