---
import '../styles/global.css';
import ConsultPrice from '../components/ConsultPrice.astro';
import profile from '../content/profile.json';

const { consult } = profile;

export interface Props {
  title?: string;
  currentPage?: 'home' | 'learn' | 'consult' | 'journal';
  showStickyConsult?: boolean;
}

const {
  title = '涂工 · AI 网球教学',
  currentPage = 'home',
  showStickyConsult = true,
} = Astro.props;

const siteName = '涂工网球';
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="涂工 AI 网球教学与咨询：交互式技术专题、动作诊断、国际案例解读。"
    />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <nav class="top-nav">
      <div class="container nav-inner">
        <a href="/" class="nav-logo">🎾 {siteName}</a>
        <div class="nav-links">
          <a href="/" class={`nav-link${currentPage === 'home' ? ' active' : ''}`}>首页</a>
          <a href="/learn/" class={`nav-link${currentPage === 'learn' ? ' active' : ''}`}>教学</a>
          <a href="/consult/" class={`nav-link${currentPage === 'consult' ? ' active' : ''}`}>咨询</a>
          <a href="/journal/" class={`nav-link${currentPage === 'journal' ? ' active' : ''}`}>资讯</a>
        </div>
      </div>
    </nav>

    <main class="page-main">
      <slot />
    </main>

    {
      showStickyConsult && (
        <div class="sticky-consult">
          <div class="sticky-consult-inner">
            <div class="sticky-consult-text">
              <strong>预约咨询</strong>
              <span class="sticky-consult-meta">
                动作诊断{' '}
                <ConsultPrice
                  original={consult.skuPriceOriginal}
                  suffix={consult.skuPriceSuffix}
                  strikethrough={consult.skuPriceStrikethrough}
                  compact
                />
                {' '}· 飞书联系
              </span>
            </div>
            <a href="/consult/" class="btn btn-primary">立即咨询</a>
          </div>
        </div>
      )
    }
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans SC', sans-serif;
    line-height: 1.8;
    min-height: 100vh;
  }

  .container {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .top-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(250, 249, 247, 0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border, #e8e4df);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
  }

  .nav-logo {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text, #2d2a26);
    text-decoration: none;
    white-space: nowrap;
  }

  .nav-links {
    display: flex;
    gap: 0.15rem;
  }

  .nav-link {
    font-size: 0.85rem;
    color: var(--text-muted, #6b6560);
    text-decoration: none;
    padding: 0.4rem 0.65rem;
    border-radius: 8px;
    transition: all 0.2s;
    white-space: nowrap;
  }
  .nav-link:hover {
    background: var(--tag-bg, #f3ebe6);
    color: var(--text, #2d2a26);
  }
  .nav-link.active {
    background: var(--accent, #e07a5f);
    color: white;
  }

  @media (max-width: 480px) {
    .nav-logo {
      font-size: 0.85rem;
    }
    .nav-link {
      font-size: 0.78rem;
      padding: 0.35rem 0.45rem;
    }
  }
</style>
